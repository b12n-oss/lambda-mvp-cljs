{:tasks
 {:requires ([babashka.process :as p])

  info {:doc "task cheat-sheet"
        :task (do (println "lambda-mvp-cljs -- AWS Lambda demo handler in ClojureScript")
                  (println "")
                  (println "  bb build       shadow-cljs release -> dist/lambda.zip")
                  (println "  bb smoke       local smoke: invoke the compiled handler with a canned event (no AWS)")
                  (println "  bb test        run script/bench.clj's unit tests")
                  (println "  bb demo        build + deploy + invoke in one go, prerequisites checked first")
                  (println "  bb deploy      idempotent: IAM role + Lambda function, create or update")
                  (println "  bb invoke      single ad-hoc invoke, prints response + REPORT line")
                  (println "  bb bench       cold/warm boot-time comparison across memory tiers")
                  (println "  bb teardown    delete the function + role")
                  (println "  bb clean       remove build artifacts")
                  (println "")
                  (println "(babashka is required for every task above except the plain node/npm")
                  (println " commands shadow-cljs itself runs -- test/deploy/invoke/teardown/bench")
                  (println " shell out to a real `bb` binary internally, same as both siblings.)")
                  (println "")
                  (println "No task hardcodes an AWS profile, account, or region -- see README.md"))}

  test {:doc "run script/bench.clj's unit tests"
        :task (p/shell "bb" "test/bench_test.clj")}

  clean {:doc "remove build artifacts"
         :task (p/shell "rm" "-rf" "dist" "out" ".shadow-cljs" ".cpcache")}

  build {:doc "shadow-cljs release -> dist/lambda.zip"
         :task (do
                 (p/shell "rm" "-rf" "dist")
                 (p/shell "mkdir" "dist")
                 (let [{:keys [exit]} (p/shell {:continue true} "npx" "shadow-cljs" "release" "lambda"
                                               "--config-merge" "{:output-to \"dist/index.js\"}")]
                   (when-not (zero? exit)
                     (println "build: shadow-cljs release failed")
                     (System/exit exit)))
                 (p/shell "cp" "package.json" "dist/package.json")
                 (let [{:keys [exit]} (p/shell {:continue true :dir "dist"} "npm" "install" "--omit=dev")]
                   (when-not (zero? exit)
                     (println "build: npm install failed")
                     (System/exit exit)))
                 (p/shell {:continue true} "rm" "-f" "dist/package-lock.json")
                 (let [{:keys [exit]} (p/shell {:continue true :dir "dist"} "zip" "-r" "lambda.zip" ".")]
                   (System/exit exit)))}

  deploy {:doc "idempotent: IAM role + Lambda function, create or update"
          :task (p/shell "bb" "script/aws_lifecycle.clj" "deploy")}

  invoke {:doc "single ad-hoc invoke, prints response + REPORT line"
          :task (p/shell "bb" "script/aws_lifecycle.clj" "invoke")}

  teardown {:doc "delete the function + role"
            :task (p/shell "bb" "script/aws_lifecycle.clj" "teardown")}

  bench {:doc "cold/warm boot-time comparison across memory tiers"
         :task (p/shell "bb" "script/bench_run.clj")}

  demo {:doc "build + deploy + invoke in one go, checking every prerequisite before starting"
        :task (p/shell "bb" "script/demo.clj")}

  smoke {:doc "local smoke: invoke the compiled handler with a canned event (run `bb build` first)"
         :task (if-not (.exists (java.io.File. "dist/index.js"))
                 (do (println "smoke: dist/index.js not found -- run `bb build` first")
                     (System/exit 1))
                 (let [{:keys [exit]} (p/shell {:continue true} "node" "-e"
                                               (str "const m = require('./dist/index.js');"
                                                    "const ctx = {awsRequestId: 'smoke-test-req'};"
                                                    "const r1 = m.handler({name: 'jolt', n: 1}, ctx);"
                                                    "const r2 = m.handler({name: 'jank', n: 2}, ctx);"
                                                    "console.log('invocation 1:', JSON.stringify(r1));"
                                                    "console.log('invocation 2:', JSON.stringify(r2));"
                                                    "if (r1.warm_invocation !== 1 || r2.warm_invocation !== 2) {"
                                                    "  console.error('smoke: warm_invocation did not increment as expected');"
                                                    "  process.exit(1);"
                                                    "}"
                                                    "if (r1.request_id !== 'smoke-test-req') {"
                                                    "  console.error('smoke: request_id did not come through');"
                                                    "  process.exit(1);"
                                                    "}"
                                                    "console.log('smoke: PASS');"))]
                   (System/exit exit)))}}}
